 "notes": [
  {
   "id": "np8-01",
   "cat": "grammar",
   "label": "Superlative",
   "quote": "acerrime",
   "trans": "most energetically",
   "line": "",
   "body": "The superlative adverb shows Hannibal throwing all his energy into preparing for more war, which makes the peace made behind his back all the more of a blow.",
   "exam": ""
  },
  {
   "id": "np8-02",
   "cat": "structure",
   "label": "Contrast",
   "quote": "cum in apparando acerrime esset occupatus, Carthaginienses bellum cum Romanis composuerunt",
   "trans": "while he was busy preparing, the Carthaginians made peace with the Romans",
   "line": "",
   "body": "Hannibal's preparations for war are set against his city making peace. This is the first sign of the split between Hannibal and his own people that leads to his exile.",
   "exam": ""
  },
  {
   "id": "np8-03",
   "cat": "diction",
   "label": "Emphasis",
   "quote": "nihilo setius",
   "trans": "none the less",
   "line": "",
   "body": "The phrase shows Hannibal carrying on regardless, as if the peace did not apply to him.",
   "exam": ""
  },
  {
   "id": "np8-04",
   "cat": "structure",
   "label": "Pairing",
   "quote": "itemque Mago frater eius",
   "trans": "and likewise his brother Mago",
   "line": "",
   "body": "Mago is linked to Hannibal, so the Barca brothers act as one. This prepares for the senate naming them both in its reply.",
   "exam": ""
  },
  {
   "id": "np8-05",
   "cat": "diction",
   "label": "Roman point of view",
   "quote": "P. Sulpicium C. Aurelium consules",
   "trans": "the consuls Publius Sulpicius and Gaius Aurelius",
   "line": "",
   "body": "Nepos dates events in Carthage by the Roman consuls, so the story is told from Rome's side even when the scene is Africa.",
   "exam": ""
  },
  {
   "id": "np8-06",
   "cat": "structure",
   "label": "Tricolon",
   "quote": "qui … gratias agerent … donarent … peterent",
   "trans": "to thank … to present … to ask",
   "line": "",
   "body": "The envoys come to thank, to give and only then to ask. Putting the thanks and the gift first shows Carthage humbly trying to win Rome's goodwill.",
   "exam": ""
  },
  {
   "id": "np8-07",
   "cat": "diction",
   "label": "Vivid detail",
   "quote": "corona aurea",
   "trans": "with a golden crown",
   "line": "",
   "body": "A gift of gold shows how eager the Carthaginians are to please Rome, which makes their general's continued command look like an embarrassment.",
   "exam": ""
  },
  {
   "id": "np8-08",
   "cat": "grammar",
   "label": "Indirect speech",
   "quote": "responsum est: munus eorum gratum acceptumque esse",
   "trans": "the reply was that their gift was welcome and accepted",
   "line": "",
   "body": "The senate's answer is reported in indirect statement, which gives it the cool, formal tone of an official decree.",
   "exam": ""
  },
  {
   "id": "np8-09",
   "cat": "structure",
   "label": "Pairing",
   "quote": "gratum acceptumque",
   "trans": "welcome and accepted",
   "line": "",
   "body": "Two near-synonyms make the reply sound gracious, which makes the refusal that follows all the sharper.",
   "exam": ""
  },
  {
   "id": "np8-10",
   "cat": "structure",
   "label": "Contrast",
   "quote": "obsides … captivos non remissuros",
   "trans": "the hostages … they would not return the prisoners",
   "line": "",
   "body": "The senate grants the first request and refuses the second. The balanced reply makes the \"no\" stand out.",
   "exam": ""
  },
