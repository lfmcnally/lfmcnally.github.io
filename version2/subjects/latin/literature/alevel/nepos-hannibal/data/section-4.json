 "notes": [
  {
   "id": "np4-01",
   "cat": "grammar",
   "label": "Fast pace",
   "quote": "cuius post obitum, Hasdrubale imperatore suffecto … hoc quoque interfecto",
   "trans": "after his death, with Hasdrubal appointed commander … when he too was killed",
   "line": "",
   "body": "Two ablative absolutes dispose of two commanders in a few words, hurrying the story on to the moment Hannibal takes charge.",
   "exam": ""
  },
  {
   "id": "np4-02",
   "cat": "diction",
   "label": "Characterisation",
   "quote": "equitatui omni praefuit",
   "trans": "he commanded all the cavalry",
   "line": "",
   "body": "Even before he is in overall command, Hannibal is given a major responsibility, which marks him out early.",
   "exam": ""
  },
  {
   "id": "np4-03",
   "cat": "structure",
   "label": "Polyptoton",
   "quote": "detulit … delatum",
   "trans": "conferred … reported",
   "line": "",
   "body": "The same verb is used for the army giving him command and the news being brought to Carthage, linking the soldiers' choice to the city's approval.",
   "exam": ""
  },
  {
   "id": "np4-04",
   "cat": "diction",
   "label": "Emphasis",
   "quote": "publice comprobatum est",
   "trans": "was officially approved",
   "line": "",
   "body": "Nepos stresses that Hannibal's command was legitimate, approved by the state, not seized by force.",
   "exam": ""
  },
  {
   "id": "np4-05",
   "cat": "diction",
   "label": "Emphasis",
   "quote": "minor V et XX annis natus",
   "trans": "under twenty-five years old",
   "line": "",
   "body": "His youth is spelt out precisely, so the reader is struck by how young he was to command a whole army.",
   "exam": ""
  },
  {
