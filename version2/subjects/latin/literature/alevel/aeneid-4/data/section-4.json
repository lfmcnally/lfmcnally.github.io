 "notes": [
  {
   "id": "np4-01",
   "cat": "diction",
   "label": "Dramatic irony",
   "quote": "dis … auspicibus … Iunone secunda",
   "trans": "with the gods as guides … and Juno favourable",
   "line": "45",
   "body": "Anna thinks the gods favour the match. The reader knows that Juno does support it, but only to keep Aeneas from Italy.",
   "exam": ""
  },
  {
   "id": "np4-02",
   "cat": "diction",
   "label": "Word choice",
   "quote": "auspicibus",
   "trans": "as guides",
   "line": "45",
   "body": "Auspices were signs read from birds before any public act. Anna presents the Trojans' arrival as divinely approved, like an official undertaking.",
   "exam": ""
  },
