 "notes": [
  {
   "id": "pupugit-altius",
   "cat": "imagery",
   "label": "Dramatic Irony",
   "quote": "pupugit altius",
   "trans": "she pricked (herself) too deeply",
   "body": "Handling the god’s own weapons, Psyche pricks herself on one of his arrows — and <em>pupugit altius</em> (\"pricked too deep\"). The arrows of Love do their work: she is wounded into loving the very god lying before her.",
   "exam": "<strong>In an exam:</strong> \"The irony of <em>pupugit altius</em> is the turning point: testing Cupid’s arrow, Psyche wounds herself and so literally falls in love with Love, the weapon working on its own mistress.\"",
   "line": ""
  },
