 ],
 "notes": [
  {
   "id": "membris-dissipatis",
   "cat": "imagery",
   "label": "Gory Imagery",
   "quote": "membris iactatis atque dissipatis ... laceratis visceribus",
   "trans": "her limbs tossed about and scattered ... her innards torn apart",
   "body": "The sister’s death is told in unsparing, butcherly detail: <em>membra iactata</em> and <em>dissipata</em> (\"limbs flung and scattered\"), <em>viscera lacerata</em> (\"innards torn\"). The piled-up participles of mangling deliver the chapter title’s promised \"sticky end\".",
   "exam": "<strong>In an exam:</strong> \"The accumulation of violent participles (<em>iactatis ... dissipatis ... laceratis</em>) renders the sister’s dismemberment with grim, almost gleeful precision, the gory detail inviting satisfaction rather than pity at her deserved fate.\"",
   "line": ""
  },
  {
   "id": "ut-merebatur",
   "cat": "imagery",
   "label": "Poetic Justice",
   "quote": "proinde ut merebatur",
   "trans": "accordingly, as she deserved",
   "body": "The narrator’s aside <em>ut merebatur</em> (\"as she deserved\") makes the gore moral. This is not random cruelty but earned punishment — the wicked sister gets exactly what her treachery has earned, and the reader is told so plainly.",
   "exam": "<strong>In an exam:</strong> \"The pointed comment <em>ut merebatur</em> frames the sister’s horrific death as just deserts, steering the reader’s response: her suffering is presented not as tragedy but as fitting retribution.\"",
   "line": ""
  },
  {
   "id": "pabulum",
   "cat": "imagery",
   "label": "Degrading Image",
   "quote": "alitibus bestiisque obvium ferens pabulum",
   "trans": "providing ready food for birds and beasts",
   "body": "Her body’s final use is as carrion: <em>pabulum</em> (\"fodder\") <em>obvium</em> (\"ready to hand\") for the <em>alites</em> and <em>bestiae</em>. The woman who schemed for a god’s bed ends as a meal for scavengers — a bathetic, contemptuous close.",
   "exam": "<strong>In an exam:</strong> \"The image of the corpse as <em>pabulum</em> for birds and beasts degrades the ambitious sister utterly: she who plotted to wed a god becomes mere fodder, a humiliating bathos that completes her punishment.\"",
   "line": ""
  },
  {
   "id": "vindictae-tardavit",
   "cat": "imagery",
   "label": "Swift Retribution",
   "quote": "nec vindictae sequentis poena tardavit",
   "trans": "nor was the punishment of the revenge that followed slow",
   "body": "A crisp transitional sentence promises the same again: the <em>poena</em> of the second sister’s <em>vindicta</em> \"was not slow\". The litotes (<em>nec ... tardavit</em>) hurries us straight on to her identical doom.",
